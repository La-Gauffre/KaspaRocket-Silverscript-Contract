pragma silverscript ^0.1.0;

// Escrow_sell_token — limit SELL order for one KCC20 token.
//
// The order creator locks tokens in a KCC20 UTXO owned by this covenant (the
// vault), asking kas_per_token for each. Anyone can fill it, fully or
// partially, by paying the seller in KAS; the buyer receives the tokens from
// the vault. The creator can cancel at any time and take the tokens back.
contract Escrow_sell_token_KCC20ref(
    byte[32] init_creator_pk,
    byte[36] init_seller_spk,
    int init_kas_per_token,
    int init_tokens_remaining,
    byte[32] init_token_id,
    byte[36] init_fee_recipient,
    int kcc20_prefix_len,
    int kcc20_suffix_len,
    byte[32] kcc20_hash,
    byte[] kcc20_prefix,
    byte[] kcc20_suffix
) {
    // Order state: who placed it, where the KAS goes, price and size.
    byte[32] creator_pk    = init_creator_pk;
    byte[36] seller_spk    = init_seller_spk;
    int kas_per_token      = init_kas_per_token;
    int tokens_remaining   = init_tokens_remaining;
    byte[32] token_id      = init_token_id;
    byte[36] fee_recipient = init_fee_recipient;

    // Layout of a KCC20 state, used to read the vault and check token outputs.
    struct KCC20State {
        byte[32] kcc20_template;
        int amount;
        byte[32] owner;
        byte owner_scheme;
        byte borrow_scheme;
        byte[32] borrow_guard;
        byte[32] extension_commitment;
    }

    // KCC20 owner schemes.
    byte constant OWNER_P2PK_SCHNORR  = 0x00;
    byte constant OWNER_P2PKH_SCHNORR = 0x01;
    byte constant OWNER_P2PKH_ECDSA   = 0x02;
    byte constant OWNER_P2SH          = 0x03;
    byte constant OWNER_COVENANT_ID   = 0x04;

    byte constant BORROW_DISABLED = 0x00;

    // Minimum platform fee enforced on-chain: 0.3% of the KAS paid.
    int constant FEE_NUM = 3;
    int constant FEE_DEN = 1000;

    int constant MAX_KCC20_SCAN = 10;

    int constant MAX_KAS_FLOW = 3_000_000_000_000_000_000;

    // Output layout. Each covenant input owns a block of 4 outputs at the end
    // of the transaction, so several orders can be filled in one transaction.
    int constant BLOCK            = 4;
    int constant SLOT_ESCROW      = 0;
    int constant SLOT_BUYER_TOKEN = 1;
    int constant SLOT_SELLER_KAS  = 2;
    int constant SLOT_FEE         = 3;

    byte constant SIGHASH_ALL = 0x01;

    // Shared checks.
    function blockBase() : int {
        int base = tx.outputs.length - BLOCK * (this.activeInputIndex + 1);
        require(base >= 0);
        return base;
    }

    function kasFlow(State prev, int fill_amount) : int {
        require(prev.kas_per_token > 0);
        require(fill_amount > 0);
        require(fill_amount <= MAX_KAS_FLOW / prev.kas_per_token);
        return fill_amount * prev.kas_per_token;
    }

    // Find this order's vault: exactly one token input owned by this covenant.
    function scanVault(byte[32] token, byte[32] myCovId) : (int, byte, int) {
        int kcc20_total = OpCovInputCount(token);
        require(kcc20_total <= MAX_KCC20_SCAN);

        int vault_count     = 0;
        int tokens_in_vault = 0;
        byte vault_borrow_scheme = BORROW_DISABLED;
        int vault_idx = 0;
        for (n, 0, kcc20_total, MAX_KCC20_SCAN) {
            int candidate_idx = OpCovInputIdx(token, n);
            KCC20State candidate = readInputStateWithTemplate(
                candidate_idx,
                kcc20_prefix_len,
                kcc20_suffix_len,
                kcc20_hash
            );
            if (candidate.owner        == myCovId
             && candidate.owner_scheme == OWNER_COVENANT_ID) {
                vault_count         = vault_count + 1;
                tokens_in_vault     = candidate.amount;
                vault_borrow_scheme = candidate.borrow_scheme;
                vault_idx           = candidate_idx;
            }
        }
        require(vault_count == 1);
        return (tokens_in_vault, vault_borrow_scheme, vault_idx);
    }

    function checkImmutable(State prev, State next) {
        require(next.creator_pk    == prev.creator_pk);
        require(next.seller_spk    == prev.seller_spk);
        require(next.kas_per_token == prev.kas_per_token);
        require(next.token_id      == prev.token_id);
        require(next.fee_recipient == prev.fee_recipient);
    }

    function checkFeeOutput(State prev, int base, int kas_amount) {
        int fee = (kas_amount * FEE_NUM) / FEE_DEN;
        require(fee > 0);
        require(tx.outputs[base + SLOT_FEE].value >= fee);
        require(tx.outputs[base + SLOT_FEE].scriptPubKey == byte[](prev.fee_recipient));
    }

    // The seller is paid at least the price of the tokens bought.
    function checkSellerPayment(State prev, int base, int kas_owed) {
        int out_idx = base + SLOT_SELLER_KAS;
        require(tx.outputs[out_idx].value        >= kas_owed);
        require(tx.outputs[out_idx].scriptPubKey == byte[](prev.seller_spk));
    }

    // The buyer receives exactly fill_amount tokens, as a token UTXO it owns.
    function checkBuyerTokenOutput(State prev, int base, KCC20State expected, byte[32] buyer_pk, int fill_amount) {
        int out_idx = base + SLOT_BUYER_TOKEN;
        validateOutputStateWithTemplate(
            out_idx,
            expected,
            kcc20_prefix,
            kcc20_suffix,
            kcc20_hash
        );
        require(OpOutputCovenantId(out_idx) == prev.token_id);
        require(expected.kcc20_template == kcc20_hash);
        require(expected.owner         == buyer_pk);
        require(expected.owner_scheme  != OWNER_COVENANT_ID);
        require(expected.borrow_scheme == BORROW_DISABLED);
        require(expected.amount        == fill_amount);
    }

    // fill — partial fill. The vault is rebuilt with the remaining tokens and
    // the order continues.
    #[covenant(binding = auth, from = 1, to = 1, groups = single)]
    function fill(
        State      prev,
        State[]    newStates,
        int        fill_amount,
        int        kcc20_vault_out_idx,
        KCC20State nextKcc20Vault,
        KCC20State nextKcc20Buyer,
        byte[32]   buyer_pk
    ) {
        require(newStates.length == 1);
        State next = newStates[0];

        byte[32] myCovId = OpInputCovenantId(this.activeInputIndex);
        (int tokens_in_vault, byte vault_borrow_scheme, int vault_idx) = scanVault(prev.token_id, myCovId);
        require(tokens_in_vault == prev.tokens_remaining);
        require(vault_borrow_scheme == BORROW_DISABLED);

        require(fill_amount > 0);
        require(fill_amount < tokens_in_vault);

        int kas_owed = kasFlow(prev, fill_amount);

        int base = blockBase();
        require(OpAuthOutputIdx(this.activeInputIndex, 0) == base + SLOT_ESCROW);

        checkSellerPayment(prev, base, kas_owed);

        checkBuyerTokenOutput(prev, base, nextKcc20Buyer, buyer_pk, fill_amount);

        checkFeeOutput(prev, base, kas_owed);

        require(nextKcc20Vault.kcc20_template == kcc20_hash);
        require(nextKcc20Vault.owner         == myCovId);
        require(nextKcc20Vault.owner_scheme  == OWNER_COVENANT_ID);
        require(nextKcc20Vault.borrow_scheme == BORROW_DISABLED);
        require(nextKcc20Vault.amount        == tokens_in_vault - fill_amount);

        validateOutputStateWithTemplate(
            kcc20_vault_out_idx,
            nextKcc20Vault,
            kcc20_prefix,
            kcc20_suffix,
            kcc20_hash
        );
        require(OpOutputCovenantId(kcc20_vault_out_idx) == prev.token_id);

        checkImmutable(prev, next);
        require(next.tokens_remaining == prev.tokens_remaining - fill_amount);
        require(tx.outputs[base + SLOT_ESCROW].value >= tx.inputs[this.activeInputIndex].value);
    }

    // close_fill — buys the whole vault and closes the order.
    #[covenant(binding = auth, from = 1, to = 1, groups = single)]
    function close_fill(
        State      prev,
        State[]    newStates,
        int        fill_amount,
        KCC20State nextKcc20Buyer,
        byte[32]   buyer_pk
    ) {
        require(newStates.length == 0);

        byte[32] myCovId = OpInputCovenantId(this.activeInputIndex);
        (int tokens_in_vault, byte vault_borrow_scheme, int vault_idx) = scanVault(prev.token_id, myCovId);
        require(tokens_in_vault == prev.tokens_remaining);
        require(vault_borrow_scheme == BORROW_DISABLED);

        require(fill_amount > 0);
        require(fill_amount == prev.tokens_remaining);
        require(fill_amount == tokens_in_vault);

        int kas_owed = kasFlow(prev, fill_amount);

        int base = blockBase();

        checkSellerPayment(prev, base, kas_owed);

        checkBuyerTokenOutput(prev, base, nextKcc20Buyer, buyer_pk, fill_amount);

        checkFeeOutput(prev, base, kas_owed);
    }

    // cancel — the creator closes the order: the remaining tokens (with the KAS
    // carried by the vault and the escrow) go back to the creator, or just the
    // KAS if the vault is empty.
    #[covenant.singleton(mode = transition, termination = allowed)]
    function cancel(State prev_state, State[] next_states, sig creator_sig, KCC20State refund) : (State[]) {
        byte[] raw_sig = byte[](creator_sig);
        require(raw_sig.length == 65);
        require(raw_sig[64] == SIGHASH_ALL);
        require(checkSig(creator_sig, pubkey(prev_state.creator_pk)));

        require(next_states.length == 0);

        int refund_idx = this.activeInputIndex;
        int escrow_kas = tx.inputs[this.activeInputIndex].value;

        if (prev_state.tokens_remaining > 0) {
            byte[32] myCovId = OpInputCovenantId(this.activeInputIndex);
            (int tokens_in_vault, byte vault_borrow_scheme, int vault_idx) = scanVault(prev_state.token_id, myCovId);

            validateOutputStateWithTemplate(
                refund_idx,
                refund,
                kcc20_prefix,
                kcc20_suffix,
                kcc20_hash
            );
            require(OpOutputCovenantId(refund_idx) == prev_state.token_id);
            require(refund.kcc20_template == kcc20_hash);
            require(refund.owner         == prev_state.creator_pk);
            require(refund.owner_scheme  == OWNER_P2PK_SCHNORR);
            require(refund.borrow_scheme == BORROW_DISABLED);
            require(refund.amount        == tokens_in_vault);
            require(tx.outputs[refund_idx].value >= tx.inputs[vault_idx].value + escrow_kas);
        } else {
            byte[] creator_spk = byte[](new ScriptPubKeyP2PK(pubkey(prev_state.creator_pk)));
            require(tx.outputs[refund_idx].scriptPubKey == creator_spk);
            require(tx.outputs[refund_idx].value >= escrow_kas);
        }

        return next_states;
    }
}
