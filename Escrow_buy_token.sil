pragma silverscript ^0.1.0;

// Escrow_buy_token — limit BUY order for one KCC20 token.
//
// The order creator locks KAS in this UTXO, offering kas_per_token for up to
// tokens_remaining tokens. Anyone can fill it, fully or partially, by
// delivering tokens to buyer_pk; the escrow releases the matching KAS. 
// The creator can cancel at any time and take the remaining KAS back.
contract Escrow_buy_token_KCC20ref(
    byte[32] init_creator_pk,
    byte[32] init_buyer_pk,
    int init_kas_per_token,
    int init_tokens_remaining,
    byte[32] init_token_id,
    byte[36] init_fee_recipient,
    int kcc20_prefix_len,
    int kcc20_suffix_len,
    byte[32] kcc20_hash,
    byte[] kcc20_prefix,
    byte[] kcc20_suffix
) {
    // Order state: who placed it, who receives the tokens, price and size.
    byte[32] creator_pk      = init_creator_pk;
    byte[32] buyer_pk        = init_buyer_pk;
    int kas_per_token        = init_kas_per_token;
    int tokens_remaining     = init_tokens_remaining;
    byte[32] token_id        = init_token_id;
    byte[36] fee_recipient   = init_fee_recipient;

    // Layout of a KCC20 state, used to check the token outputs and inputs.
    struct KCC20State {
        byte[32] kcc20_template;
        int amount;
        byte[32] owner;
        byte owner_scheme;
        byte borrow_scheme;
        byte[32] borrow_guard;
        byte[32] extension_commitment;
    }

    // KCC20 owner schemes.
    byte constant OWNER_P2PK_SCHNORR  = 0x00;
    byte constant OWNER_P2PKH_SCHNORR = 0x01;
    byte constant OWNER_P2PKH_ECDSA   = 0x02;
    byte constant OWNER_P2SH          = 0x03;
    byte constant OWNER_COVENANT_ID   = 0x04;

    byte constant BORROW_DISABLED = 0x00;

    // Minimum platform fee enforced on-chain: 0.3% of the KAS released.
    int constant FEE_NUM = 3;
    int constant FEE_DEN = 1000;

    int constant MAX_USER_KCC20 = 10;

    int constant MAX_KAS_FLOW = 3_000_000_000_000_000_000;

    // Output layout. Each covenant input owns a block of 4 outputs at the end
    // of the transaction, so several orders can be filled in one transaction.
    int constant BLOCK            = 4;
    int constant SLOT_ESCROW      = 0;
    int constant SLOT_BUYER_TOKEN = 1;
    int constant SLOT_SELLER_KAS  = 2;
    int constant SLOT_FEE         = 3;

    byte constant SIGHASH_ALL = 0x01;

    // Shared checks.
    function blockBase() : int {
        int base = tx.outputs.length - BLOCK * (this.activeInputIndex + 1);
        require(base >= 0);
        return base;
    }

    function kasFlow(State prev, int fill_amount) : int {
        require(prev.kas_per_token > 0);
        require(fill_amount > 0);
        require(fill_amount <= MAX_KAS_FLOW / prev.kas_per_token);
        return fill_amount * prev.kas_per_token;
    }

    function checkImmutable(State prev, State next) {
        require(next.creator_pk    == prev.creator_pk);
        require(next.buyer_pk      == prev.buyer_pk);
        require(next.kas_per_token == prev.kas_per_token);
        require(next.token_id      == prev.token_id);
        require(next.fee_recipient == prev.fee_recipient);
    }

    function checkFeeOutput(State prev, int base, int kas_amount) {
        int fee = (kas_amount * FEE_NUM) / FEE_DEN;
        require(fee > 0);
        require(tx.outputs[base + SLOT_FEE].value >= fee);
        require(tx.outputs[base + SLOT_FEE].scriptPubKey == byte[](prev.fee_recipient));
    }

    // The buyer receives exactly fill_amount tokens, as a plain KCC20 UTXO.
    function checkBuyerTokenOutput(State prev, int base, KCC20State expected, int fill_amount) {
        int out_idx = base + SLOT_BUYER_TOKEN;
        validateOutputStateWithTemplate(
            out_idx,
            expected,
            kcc20_prefix,
            kcc20_suffix,
            kcc20_hash
        );
        require(OpOutputCovenantId(out_idx) == prev.token_id);
        require(expected.kcc20_template == kcc20_hash);
        require(expected.owner         == prev.buyer_pk);
        require(expected.owner_scheme  == OWNER_P2PK_SCHNORR);
        require(expected.borrow_scheme == BORROW_DISABLED);
        require(expected.amount        == fill_amount);
    }

    // The filler must bring at least fill_amount tokens of its own
    // (token inputs not held by a covenant).
    function checkUserTokensIn(State prev, int fill_amount) {
        int kcc20_total    = OpCovInputCount(prev.token_id);
        int user_tokens_in = 0;
        for (n, 0, kcc20_total, MAX_USER_KCC20) {
            int kcc20_idx = OpCovInputIdx(prev.token_id, n);
            KCC20State kcc20In = readInputStateWithTemplate(
                kcc20_idx,
                kcc20_prefix_len,
                kcc20_suffix_len,
                kcc20_hash
            );
            if (kcc20In.owner_scheme != OWNER_COVENANT_ID) {
                user_tokens_in = user_tokens_in + kcc20In.amount;
            }
        }
        require(user_tokens_in >= fill_amount);
    }

    // fill — partial fill. The order continues with fewer tokens remaining
    // and the released KAS removed from its value.
    #[covenant(binding = auth, from = 1, to = 1, groups = single)]
    function fill(
        State      prev,
        State[]    newStates,
        int        fill_amount,
        KCC20State nextKcc20Buyer
    ) {
        require(newStates.length == 1);
        State next = newStates[0];

        require(fill_amount > 0);
        require(fill_amount < prev.tokens_remaining);

        int base = blockBase();

        require(OpAuthOutputIdx(this.activeInputIndex, 0) == base + SLOT_ESCROW);

        int kas_released  = kasFlow(prev, fill_amount);
        int escrow_kas_in = tx.inputs[this.activeInputIndex].value;
        require(kas_released <= escrow_kas_in);
        require(tx.outputs[base + SLOT_ESCROW].value == escrow_kas_in - kas_released);

        checkBuyerTokenOutput(prev, base, nextKcc20Buyer, fill_amount);

        checkFeeOutput(prev, base, kas_released);

        checkUserTokensIn(prev, fill_amount);

        checkImmutable(prev, next);
        require(next.tokens_remaining == prev.tokens_remaining - fill_amount);
    }

    // close_fill — fills the whole remainder and closes the order. Any KAS
    // left over is refunded to the creator.
    #[covenant(binding = auth, from = 1, to = 1, groups = single)]
    function close_fill(
        State      prev,
        State[]    newStates,
        int        fill_amount,
        KCC20State nextKcc20Buyer
    ) {
        require(newStates.length == 0);

        require(fill_amount > 0);
        require(fill_amount == prev.tokens_remaining);

        int base = blockBase();

        int kas_released  = kasFlow(prev, fill_amount);
        int escrow_kas_in = tx.inputs[this.activeInputIndex].value;
        require(kas_released <= escrow_kas_in);

        checkBuyerTokenOutput(prev, base, nextKcc20Buyer, fill_amount);

        checkFeeOutput(prev, base, kas_released);

        int leftover_kas = escrow_kas_in - kas_released;
        if (leftover_kas > 0) {
            byte[] creator_spk = byte[](new ScriptPubKeyP2PK(pubkey(prev.creator_pk)));
            require(tx.outputs[base + SLOT_ESCROW].value        == leftover_kas);
            require(tx.outputs[base + SLOT_ESCROW].scriptPubKey == creator_spk);
        }

        checkUserTokensIn(prev, fill_amount);
    }

    // cancel — the creator closes the order and takes all of its KAS back.
    #[covenant.singleton(mode = transition, termination = allowed)]
    function cancel(State prev_state, State[] next_states, sig creator_sig) : (State[]) {
        byte[] raw_sig = byte[](creator_sig);
        require(raw_sig.length == 65);
        require(raw_sig[64] == SIGHASH_ALL);
        require(checkSig(creator_sig, pubkey(prev_state.creator_pk)));

        require(next_states.length == 0);

        byte[] creator_spk = byte[](new ScriptPubKeyP2PK(pubkey(prev_state.creator_pk)));
        require(tx.outputs[this.activeInputIndex].scriptPubKey == creator_spk);
        require(tx.outputs[this.activeInputIndex].value >= tx.inputs[this.activeInputIndex].value);

        return next_states;
    }
}
