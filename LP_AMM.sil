pragma silverscript ^0.1.0;

// LP_AMM — liquidity pool for one KCC20 token, paired with KAS.
//
// The pool starts on a quadratic bonding curve. Once the circulating supply S
// reaches S1 it switches, irreversibly, to a constant-product AMM. The token
// reserve lives in a separate KCC20 UTXO owned by this covenant (the vault);
// the KAS reserve is the value of that vault UTXO.
//
// Constructor: curve parameters, initial state, the token id, the fee
// recipient, and the KCC20 template used to recognise and rebuild the vault.
contract LP_AMM_KCC20ref(
    int init_a_num,
    int init_a_den,
    int init_b,
    int init_S1,
    int init_S,
    int init_vault_tokens,
    int init_vault_kas,
    int init_binary_flag,
    byte[32] init_token_id,
    byte[36] init_fee_recipient,
    int kcc20_prefix_len,
    int kcc20_suffix_len,
    byte[32] kcc20_hash,
    byte[] kcc20_prefix,
    byte[] kcc20_suffix
) {
    // Pool state.
    // binary_flag: 0 = bonding curve, 1 = AMM. S: tokens sold on the curve.
    int binary_flag = init_binary_flag;
    int a_num = init_a_num;
    int a_den = init_a_den;
    int b = init_b;
    int S1 = init_S1;
    int S = init_S;

    int vault_tokens = init_vault_tokens;
    int vault_kas = init_vault_kas;

    byte[32] token_id = init_token_id;
    byte[36] fee_recipient = init_fee_recipient;

    // Layout of a KCC20 state, as read from and written to the vault UTXO.
    struct KCC20State {
        byte[32] kcc20_template;
        int amount;
        byte[32] owner;
        byte owner_scheme;
        byte borrow_scheme;
        byte[32] borrow_guard;
        byte[32] extension_commitment;
    }

    byte constant OWNER_COVENANT_ID = 0x04;

    byte constant BORROW_DISABLED = 0x00;

    // Minimum platform fee enforced on-chain: 0.3% of the KAS traded.
    int constant FEE_NUM = 3;
    int constant FEE_DEN = 1000;

    // Bounds that keep curve arithmetic within 64-bit integers.
    int constant MAX_A_NUM  = 18;
    int constant MAX_B      = 1_000_000_000;
    int constant MAX_SUPPLY = 1_000_000_000;

    int constant MIN_T_OUT = 1_000;

    int constant S2_MARGIN = 3_000;

    int constant MAX_KCC20_SCAN = 10;

    int constant MAX_KAS_FLOW = 3_000_000_000_000_000_000;

    // Output layout. Each covenant input owns a block of 4 outputs at the end
    // of the transaction, so several covenants can be settled in one transaction.
    int constant BLOCK      = 4;
    int constant SLOT_POOL  = 0;
    int constant SLOT_KCC20 = 1;
    int constant SLOT_KAS   = 2;
    int constant SLOT_FEE   = 3;

    // Index of the first output of this input's block.
    function blockBase() : int {
        int base = tx.outputs.length - BLOCK * (this.activeInputIndex + 1);
        require(base >= 0);
        return base;
    }

    // Curve parameters, token and fee recipient can never change.
    function checkImmutableState(State prev, State next) {
        require(next.a_num == prev.a_num);
        require(next.a_den == prev.a_den);
        require(next.b == prev.b);
        require(next.S1 == prev.S1);
        require(next.token_id == prev.token_id);
        require(next.fee_recipient == prev.fee_recipient);
    }

    // The fee output must pay at least the minimum fee to the fee recipient.
    function checkFeeOutput(State prev, int base, int kas_amount) {
        require(kas_amount >= 0);
        require(kas_amount <= MAX_KAS_FLOW);
        int fee = (kas_amount * FEE_NUM) / FEE_DEN;
        require(fee > 0);
        require(tx.outputs[base + SLOT_FEE].value >= fee);
        require(tx.outputs[base + SLOT_FEE].scriptPubKey == byte[](prev.fee_recipient));
    }

    // executeSwap — buy or sell `amount` tokens against the pool.
    //
    // 1. Locate this pool's vault among the token inputs and check it matches
    //    the recorded reserves.
    // 2. Price the trade: bonding curve while binary_flag == 0, constant
    //    product afterwards.
    // 3. Check the KAS moved, the fee output and the new vault state, then
    //    record the new reserves in the pool's next state.
    #[covenant(binding = auth, from = 1, to = 1, groups = single)]
    function executeSwap(
        State      prev,
        State[]    newStates,
        int        amount,
        bool       isBuy,
        KCC20State nextKcc20
    ) {
        require(newStates.length == 1);
        State next = newStates[0];

        checkImmutableState(prev, next);

        require(amount > 0);

        // The pool continues in the first output of its block.
        byte[32] myCovId = OpInputCovenantId(this.activeInputIndex);
        int base = blockBase();

        require(OpAuthOutputIdx(this.activeInputIndex, 0) == base + SLOT_POOL);

        require(tx.outputs[base + SLOT_POOL].value >= tx.inputs[this.activeInputIndex].value);

        // Find the vault: exactly one token input owned by this covenant.
        int kcc20_total = OpCovInputCount(prev.token_id);
        require(kcc20_total <= MAX_KCC20_SCAN);

        int vault_count       = 0;
        int kcc20_in_idx      = 0;
        int t_in              = 0;
        byte scanned_borrow_scheme = BORROW_DISABLED;
        for (n, 0, kcc20_total, MAX_KCC20_SCAN) {
            int candidate_idx = OpCovInputIdx(prev.token_id, n);
            KCC20State candidate = readInputStateWithTemplate(
                candidate_idx,
                kcc20_prefix_len,
                kcc20_suffix_len,
                kcc20_hash
            );
            if (candidate.owner        == myCovId
             && candidate.owner_scheme == OWNER_COVENANT_ID) {
                vault_count           = vault_count + 1;
                kcc20_in_idx          = candidate_idx;
                t_in                  = candidate.amount;
                scanned_borrow_scheme = candidate.borrow_scheme;
            }
        }
        require(vault_count == 1);

        // The vault must hold exactly the reserves recorded in the pool state.
        int kcc20_out_idx = base + SLOT_KCC20;
        int k_in  = tx.inputs[kcc20_in_idx].value;
        int k_out = tx.outputs[kcc20_out_idx].value;

        require(t_in == prev.vault_tokens);
        require(k_in == prev.vault_kas);

        require(scanned_borrow_scheme == BORROW_DISABLED);

        require(nextKcc20.kcc20_template == kcc20_hash);
        require(nextKcc20.owner         == myCovId);
        require(nextKcc20.owner_scheme  == OWNER_COVENANT_ID);
        require(nextKcc20.borrow_scheme == BORROW_DISABLED);

        // Bonding curve: price = integral of (a_num / a_den) * s + b over the supply sold.
        if (prev.binary_flag == 0) {
            require(prev.a_den > 0);

            if (isBuy) {
                int v0 = prev.S;
                int v1 = prev.S + amount;

                require(prev.a_num <= MAX_A_NUM);
                require(prev.b <= MAX_B);
                require(v1 <= MAX_SUPPLY);

                require(v1 <= prev.S1 + S2_MARGIN);

                int raw0 = (prev.a_num * v0 / 2) * v0;
                int raw1 = (prev.a_num * v1 / 2) * v1;

                int raw_delta = raw1 - raw0;
                int quad_cost = (raw_delta + prev.a_den - 1) / prev.a_den;
                int cost = quad_cost + (prev.b * v1) - (prev.b * v0);

                require(k_out >= k_in + cost);
                checkFeeOutput(prev, base, cost);

                require(nextKcc20.amount == t_in - amount);

                require(next.S == v1);

                if (next.S >= prev.S1) {
                    require(next.binary_flag == 1);
                } else {
                    require(next.binary_flag == 0);
                }
            } else {
                require(amount <= prev.S);

                int v0 = prev.S;
                int v1 = prev.S - amount;

                require(prev.a_num <= MAX_A_NUM);
                require(prev.b <= MAX_B);
                require(v0 <= MAX_SUPPLY);

                int raw0 = (prev.a_num * v0 / 2) * v0;
                int raw1 = (prev.a_num * v1 / 2) * v1;

                int raw_delta = raw0 - raw1;
                int quad_refund = raw_delta / prev.a_den;
                int refund = quad_refund + (prev.b * v0) - (prev.b * v1);

                require(refund <= k_in);
                require(k_out >= k_in - refund);
                checkFeeOutput(prev, base, refund);

                require(nextKcc20.amount == t_in + amount);

                require(next.S == v1);
                require(next.binary_flag == 0);
            }
        // AMM: constant product between the token and KAS reserves, rounded in
        // favour of the pool.
        } else {
            require(next.binary_flag == 1);
            require(next.S == prev.S);

            if (isBuy) {
                require(amount < t_in);

                int t_out = t_in - amount;

                require(t_out >= MIN_T_OUT);

                int k_gained = (k_in / t_out) * amount + ((k_in % t_out) * amount + t_out - 1) / t_out;

                require(k_out == k_in + k_gained);
                checkFeeOutput(prev, base, k_gained);

                require(nextKcc20.amount == t_out);
            } else {
                int t_out = t_in + amount;

                int k_paid = (k_in / t_out) * amount + ((k_in % t_out) * amount) / t_out;

                require(k_out == k_in - k_paid);
                checkFeeOutput(prev, base, k_paid);

                require(nextKcc20.amount == t_out);
            }
        }

        // Rebuild the vault output and record the new reserves.
        validateOutputStateWithTemplate(
            kcc20_out_idx,
            nextKcc20,
            kcc20_prefix,
            kcc20_suffix,
            kcc20_hash
        );
        require(OpOutputCovenantId(kcc20_out_idx) == prev.token_id);

        require(next.vault_tokens == nextKcc20.amount);
        require(next.vault_kas    == k_out);
    }
}
